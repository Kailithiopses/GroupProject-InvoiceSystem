<Window x:Class="InvoiceSystem.Search.wndSearch"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:InvoiceSystem.Search"
        mc:Ignorable="d"
        Title="wndSearch" Height="450" Width="800">
    <Grid Background="LightGray">
        <!-- Datagrid that displays the retrieved invoices -->
        <DataGrid x:Name="dgInvoiceDisplay" d:ItemsSource="{d:SampleData ItemCount=5}" Width="Auto" Height="Auto" Margin="37,154,263,80" SelectionChanged="dgInvoiceDisplay_SelectionChanged" CanUserAddRows="False" Background="#FFA6E0EE" BorderThickness="2" BorderBrush="Black" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="CadetBlue" ColumnHeaderHeight="30" FontFamily="Courier New" />

        <!-- Combo box to filter by Invoice ID -->
        <Label Content="Filter by ID" HorizontalAlignment="Left" Margin="59,51,0,0" VerticalAlignment="Top" FontSize="15" FontFamily="Courier New"/>
        <ComboBox x:Name="cbInvoiceNumFilter" HorizontalAlignment="Left" Margin="57,92,0,0" VerticalAlignment="Top" Width="120" SelectionChanged="ComboBox_SelectionChanged" BorderBrush="Black" Padding="5" FontSize="15" />

        <!-- Combo box to filter by Invoice Date -->
        <Label Content="Filter by Date" HorizontalAlignment="Left" Margin="226,53,0,0" VerticalAlignment="Top" FontFamily="Courier New"/>
        <ComboBox x:Name="cbInvoiceDateFilter" HorizontalAlignment="Left" Margin="226,92,0,0" VerticalAlignment="Top" Width="120" SelectionChanged="ComboBox_SelectionChanged" BorderBrush="Black" Padding="5" FontSize="15"/>

        <!-- Combo box to filter by Invoice total cost -->
        <Label Content="Filter by Total Cost" HorizontalAlignment="Left" Margin="383,53,0,0" VerticalAlignment="Top" FontFamily="Courier New"/>
        <ComboBox x:Name="cbInvoiceTotalCostFilter" HorizontalAlignment="Left" Margin="400,92,0,0" VerticalAlignment="Top" Width="120" SelectionChanged="ComboBox_SelectionChanged" BorderBrush="Black" Padding="5" FontSize="15"/>
        
        <!-- Buttons -->
        <Button x:Name="btnClearFilter" Content="Clear Filter" HorizontalAlignment="Left" Margin="618,105,0,0" VerticalAlignment="Top" Width="100" Click="btnClearFilter_Click" Padding="5" FontSize="12" FontFamily="Courier New"/>
        <Button x:Name="btnSelectInvoice" Content="Select Invoice" HorizontalAlignment="Left" Margin="618,217,0,0" VerticalAlignment="Top" Width="100" Click="btnSelectInvoice_Click" IsEnabled="False" Padding="5" FontSize="10" FontFamily="Courier New"/>
        <Button x:Name="btnCancel" Content="Cancel" HorizontalAlignment="Left" Margin="618,299,0,0" VerticalAlignment="Top" Width="100" Click="btnCancel_Click" Padding="5" FontSize="15" FontFamily="Courier New"/>


    </Grid>
</Window>
